{
  "schema_version": "0.1.0",
  "initialPageId": "estimate",
  "pages": {
    "estimate": {
      "id": "estimate",
      "components": [
        {
          "type": "text",
          "props": {
            "text": "How many jelly beans are in the jar?"
          },
          "id": "text-0"
        },
        {
          "type": "survey",
          "props": {
            "items": [
              {
                "id": "r1_estimate",
                "text": "Your estimate",
                "answer": "numeric"
              }
            ]
          },
          "id": "survey-1"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "next",
                "text": "Find a partner",
                "action": {
                  "type": "go_to",
                  "target": "matching"
                }
              }
            ]
          },
          "id": "buttons-2"
        }
      ]
    },
    "matching": {
      "id": "matching",
      "components": [
        {
          "type": "matchmaking",
          "props": {
            "poolId": "pairs",
            "onMatchTarget": "decide",
            "num_users": 2,
            "timeoutSeconds": 300,
            "timeoutTarget": "matching_timeout"
          },
          "id": "matchmaking-0"
        }
      ]
    },
    "matching_timeout": {
      "id": "matching_timeout",
      "end": true,
      "components": [
        {
          "type": "text",
          "props": {
            "text": "We couldn't find a partner. Thank you for trying!"
          },
          "id": "text-0"
        }
      ]
    },
    "decide": {
      "id": "decide",
      "components": [
        {
          "type": "text",
          "props": {
            "text": "You said **{{session_state.r1_estimate}}**. Your partner said **{{group.others.0.r1_estimate}}**."
          },
          "id": "text-0"
        },
        {
          "type": "text",
          "when": "group.others.0.r1_estimate > 500",
          "props": {
            "text": "Your partner thinks it's more than 500."
          },
          "id": "text-1"
        },
        {
          "type": "live-workspace",
          "props": {
            "mode": "structured",
            "scope": "group",
            "fields": [
              {
                "id": "r1_team_answer",
                "label": "Team answer",
                "type": "number"
              }
            ]
          },
          "id": "live-workspace-2"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "done",
                "text": "We agree",
                "action": {
                  "type": "go_to",
                  "target": "result"
                }
              }
            ]
          },
          "id": "buttons-3"
        }
      ]
    },
    "result": {
      "id": "result",
      "components": [
        {
          "type": "text",
          "props": {
            "text": "Your team answered **{{group.ws.r1_team_answer}}**."
          },
          "id": "text-0"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "finish",
                "text": "Finish",
                "action": {
                  "type": "go_to",
                  "target": "thanks"
                }
              }
            ]
          },
          "id": "buttons-1"
        }
      ]
    },
    "thanks": {
      "id": "thanks",
      "end": true,
      "components": [
        {
          "type": "text",
          "props": {
            "text": "Thank you for participating!"
          },
          "id": "text-0"
        }
      ]
    }
  },
  "matchmaking": [
    {
      "id": "pairs",
      "num_users": 2,
      "timeoutSeconds": 300,
      "timeoutTarget": "matching_timeout",
      "share": [
        "r1_estimate"
      ]
    }
  ]
}