{
  "schema_version": "0.1.0",
  "initialPageId": "intro",
  "pages": {
    "intro": {
      "id": "intro",
      "components": [
        {
          "type": "text",
          "props": {
            "text": "# Split layout demo\n\nYou will negotiate the price of a used car with an AI dealer.\nThe listing stays on screen next to the chat.\n"
          },
          "id": "text-0"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "start",
                "text": "Start negotiation",
                "action": {
                  "type": "go_to",
                  "target": "negotiate"
                }
              }
            ]
          },
          "id": "buttons-1"
        }
      ]
    },
    "negotiate": {
      "id": "negotiate",
      "layout": "split",
      "components": [
        {
          "type": "chat",
          "column": "left",
          "props": {
            "agents": [
              "dealer"
            ]
          },
          "id": "chat-0"
        },
        {
          "type": "html",
          "id": "listing",
          "column": "right",
          "props": {
            "src": "split-demo/listing.html",
            "height": 320
          }
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "end_chat",
                "text": "End negotiation",
                "action": {
                  "type": "go_to",
                  "target": "thanks"
                }
              }
            ]
          },
          "id": "buttons-2"
        }
      ]
    },
    "thanks": {
      "id": "thanks",
      "end": true,
      "components": [
        {
          "type": "text",
          "props": {
            "text": "Thank you for participating!"
          },
          "id": "text-0"
        }
      ]
    }
  },
  "agents": [
    {
      "id": "dealer",
      "model": "gpt-5-mini",
      "avatar": {
        "icon": "badge-dollar-sign"
      },
      "system": "You are a used car dealer selling a 2019 Honda Civic with 45,000 miles.\nReserve price: $12,000 (won't sell below). Starting ask: $18,000.\nBe friendly but firm. Keep responses SHORT - 1-2 sentences max.\n"
    }
  ]
}