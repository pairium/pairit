{
  "schema_version": "0.1.0",
  "initialPageId": "intro",
  "pages": {
    "intro": {
      "id": "intro",
      "onEnter": [
        {
          "type": "randomize",
          "assignmentType": "random",
          "conditions": [
            "A",
            "B"
          ],
          "stateKey": "treatment"
        }
      ],
      "components": [
        {
          "type": "text",
          "props": {
            "text": "# HTML embed demo\n\nOn the next page you will rate an item with a custom slider.\nYour condition is assigned when you continue.\n"
          },
          "id": "text-0"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "start",
                "text": "Continue",
                "action": {
                  "type": "go_to",
                  "target": "task"
                }
              }
            ]
          },
          "id": "buttons-1"
        }
      ]
    },
    "task": {
      "id": "task",
      "components": [
        {
          "type": "html",
          "id": "slider_task",
          "props": {
            "src": "html-demo/slider.html",
            "read": [
              "treatment"
            ],
            "write": [
              "rating",
              "rt_ms"
            ],
            "height": 280,
            "required": true
          },
          "events": {
            "onState": {
              "type": "slider_response"
            },
            "onDone": {
              "type": "slider_done"
            }
          }
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "next",
                "text": "Next",
                "action": {
                  "type": "go_to",
                  "target": "thanks"
                }
              }
            ]
          },
          "id": "buttons-1"
        }
      ]
    },
    "thanks": {
      "id": "thanks",
      "end": true,
      "components": [
        {
          "type": "text",
          "props": {
            "text": "# Thanks\n\nCondition: **{{session_state.treatment}}**\n\nRating: **{{session_state.rating}}**\n"
          },
          "id": "text-0"
        }
      ]
    }
  }
}