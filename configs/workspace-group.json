{
  "schema_version": "0.1.0",
  "initialPageId": "matching",
  "pages": {
    "matching": {
      "id": "matching",
      "components": [
        {
          "type": "text",
          "props": {
            "text": "# Shared workspace\n\nYou'll be paired with another participant to write a plan together, with an AI assistant.\n"
          },
          "id": "text-0"
        },
        {
          "type": "matchmaking",
          "props": {
            "poolId": "pair",
            "num_users": 2,
            "timeoutSeconds": 300,
            "timeoutTarget": "timeout"
          },
          "id": "matchmaking-1"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "go",
                "text": "Continue",
                "action": {
                  "type": "go_to",
                  "target": "doc"
                }
              }
            ]
          },
          "id": "buttons-2"
        }
      ]
    },
    "timeout": {
      "id": "timeout",
      "end": true,
      "components": [
        {
          "type": "text",
          "props": {
            "text": "We couldn't find a partner. Thanks for trying!"
          },
          "id": "text-0"
        }
      ]
    },
    "doc": {
      "id": "doc",
      "layout": "split",
      "components": [
        {
          "type": "chat",
          "props": {
            "agents": [
              "writer"
            ]
          },
          "id": "chat-0"
        },
        {
          "type": "live-workspace",
          "props": {
            "mode": "freeform",
            "scope": "group",
            "editableBy": "both",
            "initialContent": "# Shared plan\n\n## Goal\n",
            "agents": [
              "writer"
            ]
          },
          "id": "live-workspace-1"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "next",
                "text": "Next",
                "action": {
                  "type": "go_to",
                  "target": "form"
                }
              }
            ]
          },
          "id": "buttons-2"
        }
      ]
    },
    "form": {
      "id": "form",
      "layout": "split",
      "components": [
        {
          "type": "chat",
          "id": "chat-0"
        },
        {
          "type": "live-workspace",
          "props": {
            "mode": "structured",
            "scope": "group",
            "fields": [
              {
                "id": "score",
                "label": "Score",
                "type": "number"
              },
              {
                "id": "notes",
                "label": "Notes",
                "type": "textarea"
              }
            ]
          },
          "id": "live-workspace-1"
        },
        {
          "type": "buttons",
          "props": {
            "buttons": [
              {
                "id": "done",
                "text": "Done",
                "action": {
                  "type": "go_to",
                  "target": "thanks"
                }
              }
            ]
          },
          "id": "buttons-2"
        }
      ]
    },
    "thanks": {
      "id": "thanks",
      "end": true,
      "components": [
        {
          "type": "text",
          "props": {
            "text": "Thanks!"
          },
          "id": "text-0"
        }
      ]
    }
  },
  "agents": [
    {
      "id": "writer",
      "model": "gpt-6-luna",
      "reasoningEffort": "low",
      "system": "You help two people draft a shared plan in the workspace.\nEdit the document when asked. Keep chat replies to one sentence.\n"
    }
  ],
  "matchmaking": [
    {
      "id": "pair",
      "num_users": 2,
      "timeoutSeconds": 300,
      "timeoutTarget": "timeout"
    }
  ]
}